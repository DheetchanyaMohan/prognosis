# Base URL of the Prognosis backend API (see Frontend Integration Guide §2).
VITE_API_BASE_URL=prognosis-production-1c0b.up.railway.app

# Display name used in the UI shell.
VITE_APP_NAME=Prognosis

# Shown as a GitHub link in the nav bar when set. Left unset here
# deliberately — set this to your actual repository URL; the nav bar
# hides the link entirely rather than pointing at a guessed one.
# VITE_GITHUB_URL=https://github.com/DheetchanyaMohan/prognosis

# Future Enhancement — not read by any code yet.
# VITE_ENABLE_DEVTOOLS=
# VITE_ENABLE_MOCK_API=